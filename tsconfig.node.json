{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ========== 环境类型库（仅 Node.js，禁用 DOM 类型） ==========
    "lib": ["ES2023"],
    "types": ["node"],

    // ========== 覆盖根配置的 Node.js 专属选项 ==========
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "noEmit": true
  },
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "eslint.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}